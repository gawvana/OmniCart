# ==============================================================================
# OmniCart AI 2.0 — Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# ===== Application =====
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=generate-a-64-char-hex-secret-here

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBAPP_URL=https://your-omnicart-domain.com
TELEGRAM_WEBHOOK_SECRET=generate-a-32-char-random-string
BOT_MODE=polling
# BOT_MODE=webhook

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql+asyncpg://omnicart:password@localhost:5432/omnicart_db
POSTGRES_USER=omnicart
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=omnicart_db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== AI Provider =====
AI_PROVIDER=groq
# AI_PROVIDER=gemini

# Groq (Primary)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Gemini (Fallback)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ===== Rate Limiting =====
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=20

# ===== CORS =====
ALLOWED_ORIGINS=https://your-omnicart-domain.com

# ===== Observability =====
SENTRY_DSN=
